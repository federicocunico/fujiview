{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FujiView",
  "version": "0.1.0",
  "identifier": "com.fujiview.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FujiView",
      "width": 1440,
      "height": 940,
      "minWidth": 820,
      "minHeight": 600,
      "backgroundColor": "#0b0c0d",
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Fast side-by-side photo comparison",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
